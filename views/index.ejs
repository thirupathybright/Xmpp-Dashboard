<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TBI Messenger Control — <%= DOMAIN %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --void: #f5f7f9;
    --panel: #ffffff;
    --panel-raised: #ffffff;
    --wire: #dde3e8;
    --wire-bright: #c3ccd4;
    --signal: #0f9d74;
    --signal-dim: #e3f6ee;
    --signal-glow: rgba(15, 157, 116, 0.25);
    --text: #10161c;
    --text-dim: #57626c;
    --text-faint: #8b97a1;
    --good: #0f9d74;
    --warn: #b9750a;
    --critical: #d0304a;
    --font-mono: 'JetBrains Mono', ui-monospace, monospace;
    --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --void: #0a0e14;
      --panel: #12181f;
      --panel-raised: #161d25;
      --wire: #1c2530;
      --wire-bright: #2a3644;
      --signal: #3ee8b5;
      --signal-dim: #16382e;
      --signal-glow: rgba(62, 232, 181, 0.18);
      --text: #e4ecf2;
      --text-dim: #8494a3;
      --text-faint: #566270;
      --good: #3ee8b5;
      --warn: #f2b84b;
      --critical: #ff5470;
    }
  }
  :root[data-theme="dark"] {
    --void: #0a0e14;
    --panel: #12181f;
    --panel-raised: #161d25;
    --wire: #1c2530;
    --wire-bright: #2a3644;
    --signal: #3ee8b5;
    --signal-dim: #16382e;
    --signal-glow: rgba(62, 232, 181, 0.18);
    --text: #e4ecf2;
    --text-dim: #8494a3;
    --text-faint: #566270;
    --good: #3ee8b5;
    --warn: #f2b84b;
    --critical: #ff5470;
  }

  * { box-sizing: border-box; }
  html { color-scheme: light dark; }
  body {
    font-family: var(--font-sans);
    margin: 0;
    background: var(--void);
    color: var(--text);
    -webkit-font-smoothing: antialiased;
  }
  ::selection { background: var(--signal-glow); color: var(--text); }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
  }

  /* ── Shell layout: rail + content ── */
  .shell { display: flex; min-height: 100vh; }

  .rail {
    width: 232px;
    flex-shrink: 0;
    background: var(--panel);
    border-right: 1px solid var(--wire);
    display: flex;
    flex-direction: column;
    padding: 20px 14px;
    position: sticky;
    top: 0;
    height: 100vh;
    opacity: 0;
    animation: railIn 0.5s ease-out 0.05s forwards;
  }
  @keyframes railIn { from { opacity: 0; transform: translateX(-8px); } to { opacity: 1; transform: translateX(0); } }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 10px 20px;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--wire);
  }
  .brand-mark {
    width: 34px; height: 34px;
    border-radius: 9px;
    background: linear-gradient(160deg, var(--signal), var(--signal-dim));
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-mono); font-weight: 700; font-size: 13px;
    color: var(--void);
    flex-shrink: 0;
  }
  .brand-text { line-height: 1.2; }
  .brand-title { font-family: var(--font-mono); font-weight: 700; font-size: 13px; letter-spacing: 0.02em; }
  .brand-sub { font-size: 11px; color: var(--text-faint); font-family: var(--font-mono); }

  .rail-section-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
    padding: 14px 12px 6px;
  }

  .rail-link {
    display: flex; align-items: center; gap: 10px;
    padding: 9px 12px;
    border-radius: 8px;
    color: var(--text-dim);
    font-size: 13px; font-weight: 500;
    cursor: pointer;
    border: none; background: none; width: 100%; text-align: left;
    transition: background 0.12s, color 0.12s;
    font-family: var(--font-sans);
  }
  .rail-link:hover { background: var(--panel-raised); color: var(--text); }
  .rail-link.active {
    background: var(--signal-dim);
    color: var(--signal);
    font-weight: 600;
  }
  .rail-link .ic { width: 16px; text-align: center; font-size: 14px; flex-shrink: 0; }

  .rail-foot {
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--wire);
  }
  .conn-status {
    display: flex; align-items: center; gap: 8px;
    font-family: var(--font-mono); font-size: 11px; color: var(--text-dim);
    padding: 8px 12px;
  }
  .conn-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--good);
    box-shadow: 0 0 0 0 var(--signal-glow);
    animation: pulse-dot 2s ease-in-out infinite;
    flex-shrink: 0;
  }
  @keyframes pulse-dot {
    0%   { box-shadow: 0 0 0 0 var(--signal-glow); }
    70%  { box-shadow: 0 0 0 6px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }
  .signout-btn {
    width: 100%; margin-top: 8px;
    padding: 8px 12px; border-radius: 8px;
    background: none; border: 1px solid var(--wire);
    color: var(--text-dim); font-size: 12px; font-family: var(--font-sans);
    cursor: pointer;
    transition: border-color 0.12s, color 0.12s;
  }
  .signout-btn:hover { border-color: var(--critical); color: var(--critical); }

  /* ── Main content ── */
  .main { flex: 1; min-width: 0; }
  .topstrip {
    height: 56px;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 28px;
    border-bottom: 1px solid var(--wire);
    background: var(--panel);
  }
  .topstrip-title { font-family: var(--font-mono); font-size: 13px; color: var(--text-dim); }
  .topstrip-domain {
    font-family: var(--font-mono); font-size: 11px;
    background: var(--void); border: 1px solid var(--wire);
    padding: 4px 10px; border-radius: 999px; color: var(--text-dim);
  }

  .wrap { max-width: 1180px; margin: 0 auto; padding: 28px; }

  .panel { display: none; opacity: 0; }
  .panel.active { display: block; animation: panelIn 0.28s ease-out forwards; }
  @keyframes panelIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }

  /* ── Cards ── */
  .card {
    background: var(--panel);
    border: 1px solid var(--wire);
    padding: 22px;
    border-radius: 12px;
    margin-bottom: 18px;
  }
  h2 {
    margin: 0 0 16px 0; font-size: 15px; font-weight: 600;
    display: flex; align-items: center; gap: 8px;
  }
  h3 { margin: 0 0 10px 0; font-size: 13px; color: var(--text-dim); font-weight: 600; }

  /* ── Stat tiles ── */
  .stat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 12px;
    margin-bottom: 20px;
  }
  .stat-tile {
    background: var(--panel);
    border: 1px solid var(--wire);
    border-radius: 12px;
    padding: 18px 20px;
    position: relative;
    overflow: hidden;
    opacity: 0;
    animation: tileIn 0.4s ease-out forwards;
  }
  @keyframes tileIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
  .stat-tile::before {
    content: "";
    position: absolute; top: 0; left: 0; right: 0; height: 2px;
    background: linear-gradient(90deg, transparent, var(--signal), transparent);
    background-size: 200% 100%;
    animation: scan 3.5s linear infinite;
    opacity: 0.6;
  }
  @keyframes scan { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }
  .stat-label {
    font-family: var(--font-mono); font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--text-faint); margin-bottom: 10px;
  }
  .stat-value {
    font-family: var(--font-mono); font-size: 26px; font-weight: 700; color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .stat-value.accent { color: var(--signal); }

  /* ── Forms ── */
  .form-grid { display: grid; gap: 12px; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr 1fr auto; gap: 10px; align-items: end; }
  .form-row-2 { display: grid; grid-template-columns: 1fr 1fr auto; gap: 10px; align-items: end; }
  label { font-size: 11.5px; color: var(--text-dim); display: block; margin-bottom: 5px; font-weight: 500; }
  input, textarea, select {
    width: 100%; padding: 10px 12px; border-radius: 8px;
    border: 1px solid var(--wire); font-size: 13.5px;
    background: var(--void); color: var(--text);
    font-family: var(--font-sans);
    transition: border-color 0.12s, box-shadow 0.12s;
  }
  input:focus, textarea:focus, select:focus {
    outline: none; border-color: var(--signal);
    box-shadow: 0 0 0 3px var(--signal-glow);
  }
  textarea { height: 110px; resize: vertical; }

  /* ── Buttons ── */
  button, .btn {
    padding: 10px 16px; border-radius: 8px; border: 1px solid transparent;
    background: var(--text); color: var(--void); cursor: pointer; font-size: 13px; font-weight: 600;
    white-space: nowrap; display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--font-sans);
    transition: opacity 0.12s, transform 0.08s;
  }
  button:hover { opacity: .88; }
  button:active { transform: scale(0.98); }
  .btn-green { background: var(--good); color: var(--void); }
  .btn-blue  { background: var(--signal); color: var(--void); }
  .btn-amber { background: var(--warn); color: var(--void); }
  .btn-red   { background: var(--critical); color: #fff; }
  .btn-ghost { background: none; border: 1px solid var(--wire); color: var(--text-dim); }
  .btn-sm    { padding: 6px 12px; font-size: 12px; }

  /* ── Table ── */
  table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
  thead tr { background: var(--void); }
  th {
    padding: 10px 12px; text-align: left; font-weight: 600; color: var(--text-dim);
    border-bottom: 1px solid var(--wire); font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.04em;
    font-family: var(--font-mono);
  }
  td { padding: 10px 12px; border-bottom: 1px solid var(--wire); vertical-align: middle; }
  tr:last-child td { border-bottom: none; }
  tr:hover td { background: var(--void); }

  /* ── Alerts ── */
  .msg { padding: 11px 14px; border-radius: 8px; background: var(--signal-dim); border: 1px solid var(--signal); color: var(--good); margin-bottom: 16px; font-size: 13px; }
  .err { padding: 11px 14px; border-radius: 8px; background: rgba(255,84,112,0.1); border: 1px solid var(--critical); color: var(--critical); margin-bottom: 16px; white-space: pre-wrap; font-size: 13px; }

  /* ── Misc ── */
  .hint { font-size: 12px; color: var(--text-faint); margin-top: 6px; }
  .pill {
    display: inline-block; padding: 3px 10px; border-radius: 999px;
    background: var(--signal-dim); color: var(--signal); font-size: 11.5px; font-family: var(--font-mono);
  }
  code {
    background: var(--void); border: 1px solid var(--wire); padding: 2px 7px; border-radius: 6px;
    font-size: 12.5px; font-family: var(--font-mono); color: var(--text-dim);
  }
  .badge-online  { background: var(--signal-dim); color: var(--good); }
  .badge-offline { background: rgba(255,84,112,0.1); color: var(--critical); }
  .section-sub { background: var(--void); border-radius: 10px; padding: 16px; margin-bottom: 16px; }
  .section-warn { background: rgba(242,184,75,0.08); border: 1px solid var(--warn); border-radius: 10px; padding: 16px; }
  .inline-status { margin-top: 10px; display: none; }
  .empty-row td { text-align: center; color: var(--text-faint); padding: 32px; }

  @media (max-width: 860px) {
    .rail { position: fixed; z-index: 50; transform: translateX(-100%); transition: transform 0.2s; }
    .rail.open { transform: translateX(0); }
    .wrap { padding: 18px; }
  }
</style>
</head>
<body>

  <div class="shell">
    <!-- ══════════════ RAIL NAV ══════════════ -->
    <nav class="rail">
      <div class="brand">
        <div class="brand-mark">TBI</div>
        <div class="brand-text">
          <div class="brand-title">MESSENGER CONTROL</div>
          <div class="brand-sub"><%= DOMAIN %></div>
        </div>
      </div>

      <div class="rail-section-label">Overview</div>
      <button class="rail-link active" data-tab="analytics"><span class="ic">◈</span> Analytics</button>

      <div class="rail-section-label">Directory</div>
      <button class="rail-link" data-tab="users"><span class="ic">☰</span> Users</button>
      <button class="rail-link" data-tab="add-user"><span class="ic">+</span> Add User</button>
      <button class="rail-link" data-tab="edit-user"><span class="ic">✎</span> Edit User</button>

      <div class="rail-section-label">Transmit</div>
      <button class="rail-link" data-tab="broadcast"><span class="ic">▲</span> Broadcast</button>
      <button class="rail-link" data-tab="send-message"><span class="ic">→</span> Send Message</button>
      <button class="rail-link" data-tab="send-image"><span class="ic">▣</span> Send Image</button>

      <div class="rail-section-label">System</div>
      <button class="rail-link" data-tab="bots"><span class="ic">⬡</span> Bots</button>
      <button class="rail-link" data-tab="marketing"><span class="ic">◎</span> Marketing</button>

      <div class="rail-foot">
        <div class="conn-status"><span class="conn-dot"></span> LINK ACTIVE</div>
        <form method="POST" action="/logout" style="margin:0;">
          <button type="submit" class="signout-btn">Sign out</button>
        </form>
      </div>
    </nav>

    <!-- ══════════════ MAIN ══════════════ -->
    <div class="main">
      <div class="topstrip">
        <div class="topstrip-title" id="page-title">Analytics</div>
        <div class="topstrip-domain"><%= DOMAIN %></div>
      </div>

      <div class="wrap">

        <% if (typeof msg !== "undefined" && msg) { %>
          <div class="msg"><%= msg %></div>
        <% } %>
        <% if (typeof err !== "undefined" && err) { %>
          <div class="err"><%= err %></div>
        <% } %>

        <!-- ══════════════ TAB: ANALYTICS ══════════════ -->
        <div id="tab-analytics" class="panel active">
          <div class="stat-grid">
            <div class="stat-tile" style="animation-delay:0.02s;">
              <div class="stat-label">Total Accounts</div>
              <div class="stat-value accent"><%= stats.totalAccounts %></div>
            </div>
            <div class="stat-tile" style="animation-delay:0.06s;">
              <div class="stat-label">Active / 7 Days</div>
              <div class="stat-value"><%= stats.recentlyActive7d %></div>
            </div>
            <div class="stat-tile" style="animation-delay:0.10s;">
              <div class="stat-label">With Message History</div>
              <div class="stat-value"><%= stats.messages.usersWithHistory %></div>
            </div>
            <div class="stat-tile" style="animation-delay:0.14s;">
              <div class="stat-label">Approx. Messages</div>
              <div class="stat-value"><%= stats.messages.totalApproxMessages.toLocaleString() %></div>
            </div>
            <div class="stat-tile" style="animation-delay:0.18s;">
              <div class="stat-label">Group Chats</div>
              <div class="stat-value"><%= stats.groups.totalRooms %></div>
            </div>
            <div class="stat-tile" style="animation-delay:0.22s;">
              <div class="stat-label">Files Shared</div>
              <div class="stat-value"><%= stats.uploads.totalFiles %></div>
            </div>
            <div class="stat-tile" style="animation-delay:0.26s;">
              <div class="stat-label">Upload Storage</div>
              <div class="stat-value"><%= stats.uploads.totalBytesFormatted %></div>
            </div>
            <div class="stat-tile" style="animation-delay:0.30s;">
              <div class="stat-label">Pending Offline Msgs</div>
              <div class="stat-value"><%= stats.offline.usersWithPendingMessages %></div>
            </div>
          </div>

          <% if (stats.messages.mostActiveUser) { %>
          <div class="card">
            <h2>Most Active User</h2>
            <p style="color:var(--text-dim); font-size:13.5px;">
              <code><%= stats.messages.mostActiveUser %>@<%= DOMAIN %></code>
              &mdash; approximately <%= stats.messages.mostActiveUserApproxMessages.toLocaleString() %> messages archived
            </p>
          </div>
          <% } %>

          <div class="card">
            <h2>About These Numbers</h2>
            <p style="color:var(--text-faint); font-size:12.5px; line-height:1.7;">
              Message counts are estimated from Prosody's on-disk message archive and are approximate,
              not exact. "Active in last 7 days" is based on account file modification time (login,
              password change, etc). Live online/offline presence is not tracked by this dashboard.
            </p>
          </div>
        </div>

        <!-- ══════════════ TAB: USERS ══════════════ -->
        <div id="tab-users" class="panel">
          <div class="card">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
              <h2 style="margin:0;">Users (<span id="user-count"><%= users.length %></span>)</h2>
              <button class="btn-blue" onclick="loadUsersTable()">Refresh</button>
            </div>

            <table>
              <thead>
                <tr>
                  <th>#</th>
                  <th>Nickname</th>
                  <th>JID</th>
                  <th>Username</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="users-table-body">
                <% users.forEach((u, i) => { %>
                  <tr>
                    <td style="color:var(--text-faint);"><%= i + 1 %></td>
                    <td><span style="color:var(--text-faint); font-style:italic;">—</span></td>
                    <td><code><%= u %>@<%= DOMAIN %></code></td>
                    <td><%= u %></td>
                    <td>
                      <button class="btn-sm btn-amber" onclick="prefillEdit('<%= u %>')">Edit</button>
                      <button class="btn-sm btn-red" style="margin-left:4px;" onclick="deleteUser('<%= u %>')">Delete</button>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- ══════════════ TAB: ADD USER ══════════════ -->
        <div id="tab-add-user" class="panel">
          <div class="card">
            <h2>Add New User</h2>
            <form method="post" action="/users/add" class="form-grid">
              <div>
                <label>Username</label>
                <input name="username" placeholder="e.g. 7550300724" required />
              </div>
              <div>
                <label>Password</label>
                <input name="password" type="password" placeholder="password" required />
              </div>
              <div>
                <label>Nickname (display name in TBI app)</label>
                <input name="nickname" placeholder="e.g. Niraj Kumar" />
              </div>
              <button type="submit" class="btn-green" style="width:fit-content;">Create User</button>
              <div class="hint">
                Creates <strong style="color:var(--text-dim);">username@<%= DOMAIN %></strong>. Nickname is optional but recommended — it's what appears in the chat list.
              </div>
            </form>
          </div>
        </div>

        <!-- ══════════════ TAB: EDIT USER ══════════════ -->
        <div id="tab-edit-user" class="panel">

          <div class="card">
            <h2>Reset Password</h2>
            <form method="post" action="/users/passwd" class="form-grid">
              <div class="form-row-2">
                <div>
                  <label>Username</label>
                  <input name="username" id="edit-username-pass" placeholder="e.g. 7550300724" required />
                </div>
                <div>
                  <label>New Password</label>
                  <input name="password" type="password" placeholder="new password" required />
                </div>
                <button type="submit">Update Password</button>
              </div>
            </form>
          </div>

          <div class="card">
            <h2>Set Nickname</h2>
            <p class="hint" style="margin-bottom:14px;">Use this when you know the user's current password.</p>
            <div class="form-row">
              <div>
                <label>Username</label>
                <input id="nick-username" placeholder="e.g. 7550300724" />
              </div>
              <div>
                <label>Current Password</label>
                <input id="nick-password" type="password" placeholder="user's current password" />
              </div>
              <div>
                <label>Nickname</label>
                <input id="nick-nickname" placeholder="e.g. Niraj Kumar" />
              </div>
              <button class="btn-green" onclick="setNickname()">Set Nickname</button>
            </div>
            <div id="nick-status" class="inline-status"></div>
          </div>

          <div class="card section-warn">
            <h2 style="color:var(--warn);">Reset Password &amp; Set Nickname</h2>
            <p class="hint" style="margin-bottom:14px;">
              Use when you <strong style="color:var(--text-dim);">don't know</strong> the user's password. This will <strong style="color:var(--text-dim);">change their password</strong> and then set the nickname.
            </p>
            <div class="form-row">
              <div>
                <label>Username</label>
                <input id="nick-reset-username" placeholder="e.g. 7550300724" />
              </div>
              <div>
                <label>New Password</label>
                <input id="nick-reset-password" type="password" placeholder="new password for this user" />
              </div>
              <div>
                <label>Nickname</label>
                <input id="nick-reset-nickname" placeholder="e.g. Niraj Kumar" />
              </div>
              <button class="btn-amber" onclick="setNicknameWithReset()">Reset &amp; Set</button>
            </div>
            <div id="nick-reset-status" class="inline-status"></div>
          </div>

          <div class="card" style="border-color:var(--critical);">
            <h2 style="color:var(--critical);">Delete User</h2>
            <form method="post" action="/users/delete" onsubmit="return confirm('Permanently delete this user?');" class="form-grid">
              <div class="form-row-2">
                <div>
                  <label>Username</label>
                  <input name="username" id="edit-username-del" placeholder="username to delete" required />
                </div>
                <div></div>
                <button class="btn-red" type="submit">Delete User</button>
              </div>
              <div class="hint" style="color:var(--critical);">This permanently removes the XMPP account from Prosody.</div>
            </form>
          </div>

        </div>

        <!-- ══════════════ TAB: BROADCAST ══════════════ -->
        <div id="tab-broadcast" class="panel">
          <div class="card">
            <h2>Broadcast Message</h2>
            <div class="hint" style="margin-bottom:14px;">Sends a 1:1 chat message to every user via the <code>broadcast</code> bot account.</div>
            <form method="post" action="/broadcast" class="form-grid">
              <div>
                <label>Message</label>
                <textarea name="text" placeholder="Message to send to all users..."></textarea>
              </div>
              <button type="submit" style="width:fit-content;">Send Broadcast</button>
            </form>
          </div>
        </div>

        <!-- ══════════════ TAB: SEND MESSAGE ══════════════ -->
        <div id="tab-send-message" class="panel">
          <div class="card">
            <h2>Send Message</h2>
            <div class="hint" style="margin-bottom:14px;">Send a normal text message to an individual user or a group via the message bot.</div>
            <form id="send-message-form" class="form-grid">
              <div>
                <label>Message Type</label>
                <div style="display:flex; gap:16px; margin-top:6px;">
                  <label style="display:flex; align-items:center; gap:6px; font-size:13.5px; color:var(--text); margin-bottom:0; cursor:pointer; font-weight:400;">
                    <input type="radio" name="msg-type" id="msg-type-individual" value="individual" checked style="width:auto; padding:0;" />
                    Individual (1:1 chat)
                  </label>
                  <label style="display:flex; align-items:center; gap:6px; font-size:13.5px; color:var(--text); margin-bottom:0; cursor:pointer; font-weight:400;">
                    <input type="radio" name="msg-type" id="msg-type-group" value="group" style="width:auto; padding:0;" />
                    Group (MUC)
                  </label>
                </div>
              </div>
              <div>
                <label id="msg-to-label">Recipient JID</label>
                <input type="text" id="msg-to" placeholder="e.g. 7550300724@<%= DOMAIN %>" required />
                <div class="hint" id="msg-to-hint">Full JID of the individual user</div>
              </div>
              <div>
                <label>Message</label>
                <textarea id="msg-text" placeholder="Type your message here..." required></textarea>
              </div>
              <button type="submit" class="btn-green" style="width:fit-content;">Send Message</button>
            </form>
            <div id="send-message-status" class="inline-status"></div>
          </div>
        </div>

        <!-- ══════════════ TAB: SEND IMAGE ══════════════ -->
        <div id="tab-send-image" class="panel">
          <div class="card">
            <h2>Send Image with Caption</h2>
            <div class="hint" style="margin-bottom:14px;">Upload and send an image with an optional caption via the message bot.</div>
            <form id="send-image-form" class="form-grid">
              <div>
                <label>Message Type</label>
                <div style="display:flex; gap:16px; margin-top:6px;">
                  <label style="display:flex; align-items:center; gap:6px; font-size:13.5px; color:var(--text); margin-bottom:0; cursor:pointer; font-weight:400;">
                    <input type="radio" name="image-type" id="image-type-individual" value="individual" checked style="width:auto; padding:0;" />
                    Individual (1:1 chat)
                  </label>
                  <label style="display:flex; align-items:center; gap:6px; font-size:13.5px; color:var(--text); margin-bottom:0; cursor:pointer; font-weight:400;">
                    <input type="radio" name="image-type" id="image-type-group" value="group" style="width:auto; padding:0;" />
                    Group (MUC)
                  </label>
                </div>
              </div>
              <div>
                <label id="image-to-label">Recipient JID</label>
                <input type="text" id="image-to" placeholder="e.g. 7550300724@<%= DOMAIN %>" required />
                <div class="hint" id="image-to-hint">Full JID of the individual user</div>
              </div>
              <div>
                <label>Image File</label>
                <input type="file" id="image-file" accept="image/*" required style="padding:8px;" />
              </div>
              <div>
                <label>Caption (optional)</label>
                <input type="text" id="image-caption" placeholder="Caption text..." />
              </div>
              <button type="submit" class="btn-blue" style="width:fit-content;">Send Image</button>
            </form>
            <div id="image-status" class="inline-status"></div>
          </div>
        </div>

        <!-- ══════════════ TAB: BOTS ══════════════ -->
        <div id="tab-bots" class="panel">
          <div class="card">
            <h2>AI Assistant Bot</h2>
            <div class="hint" style="margin-bottom:16px;">
              Automatically replies to incoming messages using Claude Code.
            </div>
            <div style="display:flex; gap:10px; align-items:center;">
              <form method="post" action="/ai-bot/start" style="display:inline;">
                <button class="btn-green">Start AI Bot</button>
              </form>
              <form method="post" action="/ai-bot/stop" style="display:inline;">
                <button class="btn-red">Stop AI Bot</button>
              </form>
              <div id="ai-status" style="margin-left:auto;">
                <span class="pill" style="color:var(--warn); background:rgba(242,184,75,0.12);">Checking...</span>
              </div>
            </div>
          </div>

          <div class="card">
            <h2>Message Bot</h2>
            <div class="hint" style="margin-bottom:16px;">
              Used for sending API messages and images to specific users.
            </div>
            <div style="display:flex; gap:10px; align-items:center;">
              <form method="post" action="/message-bot/start" style="display:inline;">
                <button class="btn-green">Start Message Bot</button>
              </form>
              <form method="post" action="/message-bot/stop" style="display:inline;">
                <button class="btn-red">Stop Message Bot</button>
              </form>
              <div id="msg-bot-status" style="margin-left:auto;">
                <span class="pill" style="color:var(--warn); background:rgba(242,184,75,0.12);">Checking...</span>
              </div>
            </div>
          </div>
        </div>

        <!-- ══════════════ TAB: MARKETING ══════════════ -->
        <div id="tab-marketing" class="panel">
          <div class="card">
            <h2>Marketing Person Assignments</h2>
            <div class="hint" style="margin-bottom:16px;">
              Assign marketing persons to users to restrict their data access. Users will only see orders for their assigned marketing person in the AI chatbot.
            </div>
            <button class="btn-blue" onclick="loadMarketingData()">Load Data</button>

            <div id="marketing-content" style="display:none; margin-top:20px;">
              <div style="margin-bottom:16px; padding:12px; background:var(--void); border:1px solid var(--wire); border-radius:10px;">
                <strong style="font-size:12.5px; color:var(--text-dim);">Available Marketing Persons:</strong>
                <div id="marketing-persons-list" style="margin-top:8px; display:flex; flex-wrap:wrap; gap:8px;">
                  <span class="pill">Loading...</span>
                </div>
              </div>

              <table>
                <thead>
                  <tr>
                    <th>User (JID)</th>
                    <th>Assigned Marketing Person</th>
                    <th style="text-align:center;">Actions</th>
                  </tr>
                </thead>
                <tbody id="assignments-table">
                  <tr class="empty-row"><td colspan="3">Loading assignments...</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

      </div><!-- /wrap -->
    </div><!-- /main -->
  </div><!-- /shell -->

  <script>
    // ── Tab switching (rail nav) ──
    const tabTitles = {
      analytics: 'Analytics', users: 'Users', 'add-user': 'Add User', 'edit-user': 'Edit User',
      broadcast: 'Broadcast', 'send-message': 'Send Message', 'send-image': 'Send Image',
      bots: 'Bots', marketing: 'Marketing'
    };

    function switchTab(name) {
      document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
      document.querySelectorAll('.rail-link').forEach(t => t.classList.remove('active'));
      document.getElementById('tab-' + name).classList.add('active');
      document.querySelectorAll('.rail-link[data-tab="' + name + '"]').forEach(t => t.classList.add('active'));
      document.getElementById('page-title').textContent = tabTitles[name] || name;
    }

    document.querySelectorAll('.rail-link[data-tab]').forEach(btn => {
      btn.addEventListener('click', () => switchTab(btn.dataset.tab));
    });

    // ── Prefill edit tab from Users table ──
    function prefillEdit(username) {
      document.getElementById('edit-username-pass').value = username;
      document.getElementById('edit-username-del').value = username;
      document.getElementById('nick-username').value = username;
      document.getElementById('nick-reset-username').value = username;
      switchTab('edit-user');
    }

    // ── Delete user from Users table ──
    function deleteUser(username) {
      if (!confirm('Permanently delete user "' + username + '"?')) return;
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = '/users/delete';
      const inp = document.createElement('input');
      inp.name = 'username'; inp.value = username;
      form.appendChild(inp);
      document.body.appendChild(form);
      form.submit();
    }

    // ── Load users table with nicknames ──
    async function loadUsersTable() {
      const tbody = document.getElementById('users-table-body');
      tbody.innerHTML = '<tr class="empty-row"><td colspan="5">Loading nicknames...</td></tr>';
      try {
        const res = await fetch('/users/list-with-nicknames');
        const data = await res.json();
        if (!data.success) throw new Error(data.error);

        document.getElementById('user-count').textContent = data.users.length;

        if (data.users.length === 0) {
          tbody.innerHTML = '<tr class="empty-row"><td colspan="5">No users found</td></tr>';
          return;
        }

        tbody.innerHTML = data.users.map((u, i) => `
          <tr>
            <td style="color:var(--text-faint);">${i + 1}</td>
            <td>${u.nickname
              ? `<strong>${escHtml(u.nickname)}</strong>`
              : `<span style="color:var(--text-faint); font-style:italic;">—</span>`
            }</td>
            <td><code>${escHtml(u.jid)}</code></td>
            <td>${escHtml(u.username)}</td>
            <td>
              <button class="btn-sm btn-amber" onclick="prefillEdit('${escHtml(u.username)}')">Edit</button>
              <button class="btn-sm btn-red" style="margin-left:4px;" onclick="deleteUser('${escHtml(u.username)}')">Delete</button>
            </td>
          </tr>
        `).join('');
      } catch (e) {
        tbody.innerHTML = `<tr class="empty-row"><td colspan="5" style="color:var(--critical);">Failed to load: ${e.message}</td></tr>`;
      }
    }

    function escHtml(s) {
      return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // ── Bot status polling ──
    async function checkBotsStatus() {
      try {
        const res = await fetch('/bots/status');
        const data = await res.json();

        const aiEl = document.getElementById('ai-status');
        aiEl.innerHTML = data.aiBot.running
          ? '<span class="pill badge-online">● Running</span>'
          : '<span class="pill badge-offline">○ Offline</span>';

        const msgEl = document.getElementById('msg-bot-status');
        msgEl.innerHTML = data.messageBot.running
          ? '<span class="pill badge-online">● Running</span>'
          : '<span class="pill badge-offline">○ Offline</span>';
      } catch (_) {}
    }
    checkBotsStatus();
    setInterval(checkBotsStatus, 5000);
    loadUsersTable();

    // ── Send message: update placeholder based on type ──
    document.querySelectorAll('input[name="msg-type"]').forEach(radio => {
      radio.addEventListener('change', () => {
        const isGroup = document.getElementById('msg-type-group').checked;
        document.getElementById('msg-to-label').textContent = isGroup ? 'Group JID' : 'Recipient JID';
        document.getElementById('msg-to').placeholder = isGroup
          ? 'e.g. groupname@conference.<%= DOMAIN %>'
          : 'e.g. 7550300724@<%= DOMAIN %>';
        document.getElementById('msg-to-hint').textContent = isGroup
          ? 'Full JID of the MUC group room'
          : 'Full JID of the individual user';
      });
    });

    // ── Send message ──
    document.getElementById('send-message-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const to = document.getElementById('msg-to').value.trim();
      const message = document.getElementById('msg-text').value.trim();
      const isGroup = document.getElementById('msg-type-group').checked;
      const statusEl = document.getElementById('send-message-status');

      if (!to || !message) {
        statusEl.style.display = 'block'; statusEl.className = 'err';
        statusEl.textContent = 'JID and message are required.'; return;
      }

      statusEl.style.display = 'block'; statusEl.className = 'msg';
      statusEl.textContent = 'Sending message...';

      try {
        const res = await fetch('/send-message', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ to, message, messageType: isGroup ? 'groupchat' : 'chat' })
        });
        const data = await res.json();
        if (data.success) {
          statusEl.className = 'msg';
          statusEl.textContent = `Message sent to ${to}`;
          document.getElementById('msg-to').value = '';
          document.getElementById('msg-text').value = '';
        } else {
          statusEl.className = 'err';
          statusEl.textContent = data.error;
        }
      } catch (err) {
        statusEl.className = 'err';
        statusEl.textContent = err.message;
      }
    });

    // ── Send image: update placeholder based on type ──
    document.querySelectorAll('input[name="image-type"]').forEach(radio => {
      radio.addEventListener('change', () => {
        const isGroup = document.getElementById('image-type-group').checked;
        document.getElementById('image-to-label').textContent = isGroup ? 'Group JID' : 'Recipient JID';
        document.getElementById('image-to').placeholder = isGroup
          ? 'e.g. groupname@conference.<%= DOMAIN %>'
          : 'e.g. 7550300724@<%= DOMAIN %>';
        document.getElementById('image-to-hint').textContent = isGroup
          ? 'Full JID of the MUC group room'
          : 'Full JID of the individual user';
      });
    });

    // ── Send image ──
    document.getElementById('send-image-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const to = document.getElementById('image-to').value.trim();
      const imageFile = document.getElementById('image-file').files[0];
      const caption = document.getElementById('image-caption').value;
      const isGroup = document.getElementById('image-type-group').checked;
      const statusEl = document.getElementById('image-status');

      if (!imageFile) {
        statusEl.style.display = 'block'; statusEl.className = 'err';
        statusEl.textContent = 'Please select an image file'; return;
      }

      statusEl.style.display = 'block'; statusEl.className = 'msg';
      statusEl.textContent = 'Uploading image...';

      try {
        const fd = new FormData();
        fd.append('to', to);
        fd.append('image', imageFile);
        fd.append('messageType', isGroup ? 'groupchat' : 'chat');
        if (caption) fd.append('caption', caption);

        const res = await fetch('/send-image', { method: 'POST', body: fd });
        const data = await res.json();
        if (data.success) {
          statusEl.className = 'msg';
          statusEl.textContent = `Image sent to ${to}${caption ? ' — caption: "' + caption + '"' : ''}`;
          document.getElementById('image-to').value = '';
          document.getElementById('image-file').value = '';
          document.getElementById('image-caption').value = '';
        } else {
          statusEl.className = 'err';
          statusEl.textContent = data.error;
        }
      } catch (err) {
        statusEl.className = 'err';
        statusEl.textContent = err.message;
      }
    });

    // ── Nickname: set with current password ──
    async function setNickname() {
      const username = document.getElementById('nick-username').value.trim();
      const password = document.getElementById('nick-password').value.trim();
      const nickname = document.getElementById('nick-nickname').value.trim();
      const statusEl = document.getElementById('nick-status');

      if (!username || !password || !nickname) {
        statusEl.style.display = 'block'; statusEl.className = 'err';
        statusEl.textContent = 'All fields are required.'; return;
      }
      statusEl.style.display = 'block'; statusEl.className = 'msg';
      statusEl.textContent = 'Setting nickname...';

      try {
        const res = await fetch('/users/nickname', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password, nickname })
        });
        const data = await res.json();
        if (data.success) {
          statusEl.className = 'msg'; statusEl.textContent = data.message;
          document.getElementById('nick-username').value = '';
          document.getElementById('nick-password').value = '';
          document.getElementById('nick-nickname').value = '';
          loadUsersTable();
        } else {
          statusEl.className = 'err'; statusEl.textContent = data.error;
        }
      } catch (e) {
        statusEl.className = 'err'; statusEl.textContent = e.message;
      }
    }

    // ── Nickname: reset password + set nickname ──
    async function setNicknameWithReset() {
      const username = document.getElementById('nick-reset-username').value.trim();
      const newPassword = document.getElementById('nick-reset-password').value.trim();
      const nickname = document.getElementById('nick-reset-nickname').value.trim();
      const statusEl = document.getElementById('nick-reset-status');

      if (!username || !newPassword || !nickname) {
        statusEl.style.display = 'block'; statusEl.className = 'err';
        statusEl.textContent = 'All fields are required.'; return;
      }
      if (!confirm(`Change password for "${username}" and set nickname to "${nickname}"?`)) return;

      statusEl.style.display = 'block'; statusEl.className = 'msg';
      statusEl.textContent = 'Resetting password and setting nickname...';

      try {
        const res = await fetch('/users/nickname/with-reset', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, newPassword, nickname })
        });
        const data = await res.json();
        if (data.success) {
          statusEl.className = 'msg'; statusEl.textContent = data.message;
          document.getElementById('nick-reset-username').value = '';
          document.getElementById('nick-reset-password').value = '';
          document.getElementById('nick-reset-nickname').value = '';
          loadUsersTable();
        } else {
          statusEl.className = 'err'; statusEl.textContent = data.error;
        }
      } catch (e) {
        statusEl.className = 'err'; statusEl.textContent = e.message;
      }
    }

    // ── Marketing ──
    let marketingPersons = [], assignments = {}, mpUsers = [];

    async function loadMarketingData() {
      document.getElementById('marketing-content').style.display = 'block';
      try {
        const [mpRes, assignRes] = await Promise.all([
          fetch('/marketing-persons'),
          fetch('/marketing-persons/assignments')
        ]);
        const mpData = await mpRes.json();
        const assignData = await assignRes.json();

        if (mpData.success) { marketingPersons = mpData.marketingPersons; displayMarketingPersons(); }
        if (assignData.success) {
          assignments = assignData.assignments;
          mpUsers = assignData.users;
          displayAssignments();
        }
      } catch (e) { alert('Failed to load: ' + e.message); }
    }

    function displayMarketingPersons() {
      const el = document.getElementById('marketing-persons-list');
      el.innerHTML = marketingPersons.length === 0
        ? '<span class="pill badge-offline">No marketing persons found</span>'
        : marketingPersons.map(mp => `<span class="pill">${mp}</span>`).join('');
    }

    function displayAssignments() {
      const tbody = document.getElementById('assignments-table');
      if (mpUsers.length === 0) {
        tbody.innerHTML = '<tr class="empty-row"><td colspan="3">No users found</td></tr>'; return;
      }
      tbody.innerHTML = mpUsers.map(userJid => {
        const assigned = assignments[userJid] || [];
        const arr = Array.isArray(assigned) ? assigned : (assigned ? [assigned] : []);
        const safeId = userJid.replace(/[@.]/g, '_');
        return `
          <tr>
            <td><code>${userJid}</code></td>
            <td>
              <select id="mp-select-${safeId}" multiple size="4"
                      style="width:100%; padding:6px; border-radius:6px; border:1px solid var(--wire); background:var(--void); color:var(--text);"
                      onchange="handleSelectionChange('${userJid}')">
                ${marketingPersons.map(mp =>
                  `<option value="${mp}" ${arr.includes(mp) ? 'selected' : ''}>${mp}</option>`
                ).join('')}
              </select>
              <div class="hint">Hold Ctrl/Cmd to select multiple</div>
            </td>
            <td style="text-align:center;">
              ${arr.length > 0
                ? `<div style="margin-bottom:6px;">${arr.map(mp =>
                    `<span class="pill" style="font-size:11px;margin:2px;">${mp}</span>`
                  ).join('')}</div>
                  <button class="btn-sm btn-red" onclick="removeAssignment('${userJid}')">Remove All</button>`
                : `<span style="color:var(--text-faint);font-size:13px;">No assignment</span>`
              }
            </td>
          </tr>`;
      }).join('');
    }

    function handleSelectionChange(userJid) {
      const sel = document.getElementById('mp-select-' + userJid.replace(/[@.]/g, '_'));
      const selected = Array.from(sel.selectedOptions).map(o => o.value);
      if (selected.length > 0) assignMarketingPersons(userJid, selected);
    }

    async function assignMarketingPersons(userJid, persons) {
      try {
        const res = await fetch('/marketing-persons/assign', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userJid, marketingPersons: persons })
        });
        const data = await res.json();
        if (data.success) { assignments[userJid] = persons; displayAssignments(); }
        else alert('Failed: ' + data.error);
      } catch (e) { alert('Failed: ' + e.message); }
    }

    async function removeAssignment(userJid) {
      if (!confirm('Remove marketing person assignment for ' + userJid + '?')) return;
      try {
        const res = await fetch('/marketing-persons/remove', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userJid })
        });
        const data = await res.json();
        if (data.success) { delete assignments[userJid]; displayAssignments(); }
        else alert('Failed: ' + data.message);
      } catch (e) { alert('Failed: ' + e.message); }
    }
  </script>
</body>
</html>
